# Copy to .env and adjust. Keep .env private: it holds credentials.

# Control socket of kea-dhcp4 (required). Use https:// when Kea has TLS enabled.
# host.docker.internal is the Docker host; for a remote Kea use its address.
KEA_URL=http://host.docker.internal:8001
KEA_USER=
KEA_PASSWORD=
KEA_SERVER_NAME=primary
# Further Kea servers, such as an HA partner. They get every change after the
# primary and use the same credentials.
#KEA_PEERS=standby=http://192.0.2.2:8051

# Writes a hosts file of all reservations for a DNS server into this folder on the
# Docker host. It must be writable for user 65532.
#DNS_HOSTS_DIR=/var/lib/kea-roost-dns
# One or more domains, comma separated. The first is used for reverse lookups.
#DNS_HOSTS_DOMAIN=lan

# Optional arpmonitor (https://github.com/vgropp/arpmonitor) for the devices page.
# Base URL with port and without path.
ARPMONITOR_URL=http://host.docker.internal:8253

# Optional openwrt-ap-dashboard: shows where WiFi clients are connected.
APDASHBOARD_URL=http://host.docker.internal:8189

# Login of the web interface. Without it the manager stays read-only.
MANAGER_USER=admin
# Required with MANAGER_USER. Leave both empty for a read-only interface.
MANAGER_PASSWORD=

# Optional login for /metrics, which is open without it. It opens nothing else, and the
# login above does not work there. METRICS_PASSWORD_FILE can name a file instead.
#METRICS_USER=prometheus
#METRICS_PASSWORD=
# Set to false to remove /metrics altogether.
#METRICS_ENABLED=true

# Subpath behind a reverse proxy that forwards the path unchanged. Leave it empty
# when the proxy strips the path.
#MANAGER_BASE_PATH=/kea-roost

# Host port of the web interface (read by compose.yaml).
MANAGER_PORT=8080
